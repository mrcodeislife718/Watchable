[Unit]
Description=Watchable TV Living Room Client
After=network-online.target
Wants=network-online.target

[Service]
User=watchable
Environment=WATCHABLE_URL=https://WATCHABLE_PRODUCTION_HOST/tv/
ExecStart=/usr/bin/chromium --kiosk --no-first-run --disable-session-crashed-bubble ${WATCHABLE_URL}
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
